# ─────────────────────────────────────────────────────────────────────────────
# Sentinel AI — FRONTEND environment for Vercel (Next.js)
#
# Paste into: Vercel → frontend project → Settings → Environment Variables
# Apply to: Production, Preview and Development.
#
# ⚠ API_URL IS READ AT BUILD TIME. After changing it you must REDEPLOY
#   (Deployments → ⋯ → Redeploy). Saving the variable alone changes nothing:
#   the /v1 rewrite is compiled into the build (next.config.js).
# ─────────────────────────────────────────────────────────────────────────────

# The backend origin. No trailing slash, no /v1 suffix — the rewrite appends it.
# This must be the backend's stable PRODUCTION domain, not a preview URL like
# sentinel-zzrk-axj466npu-inkoolm-hackathon.vercel.app, because that changes on
# every deploy and is usually behind Vercel Deployment Protection (which would
# return an HTML login page to the proxy instead of JSON).
API_URL=https://sentinel-zzrk-inkoolm-hackathon.vercel.app

# Public URL of THIS frontend — used for metadataBase, OpenGraph tags and the
# canonical links on /brand. Falls back to https://sentinel-ai.example if unset.
NEXT_PUBLIC_SITE_URL=https://sentinel-g0n9ucjzd-inkoolm-hackathon.vercel.app

# Optional: pin the Node version (Vercel otherwise uses its default for Next 14).
# NODE_VERSION=20
