backend/sentinel.db-shm
backend/storage/
# eval/report.json is deliberately tracked: it is the recorded run the README cites, and
# `python -m eval.doc_facts` compares the documents against it (offline engine, so the file
# is reproducible). report_llm.json is not tracked — it depends on whichever model ran.
# report_llm.md *is* tracked: it is the offline_engine column, reproducible without a key.
backend/eval/report_llm.json

