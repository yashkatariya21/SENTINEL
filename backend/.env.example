# ---------------------------------------------------------------------------
# Sentinel AI - backend environment. Copy to .env and fill in.
# Secrets belong here and in your deploy platform's env store. Never commit .env.
# ---------------------------------------------------------------------------

# PostgreSQL + pgvector in production; SQLite is the zero-dependency local default.
DATABASE_URL=postgresql+psycopg://sentinel:CHANGE_ME@localhost:5432/sentinel
# DATABASE_URL=sqlite:///./sentinel.db

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_STRING
ACCESS_TOKEN_TTL_MINUTES=720

# local | supabase | clerk
AUTH_MODE=local
AUTH_JWKS_URL=
AUTH_AUDIENCE=

# local | s3   (s3 = any S3-compatible bucket: AWS, R2, Supabase Storage)
STORAGE_BACKEND=local
STORAGE_DIR=./storage
S3_BUCKET=
S3_REGION=
MAX_UPLOAD_MB=20

# local   = built-in deterministic engine, no third-party calls, no cost
# openai  = any OpenAI-compatible chat + embeddings endpoint
# anthropic = Anthropic messages API (embeddings via LLM_BASE_URL gateway)
LLM_PROVIDER=local
LLM_MODEL=sentinel-local-1
EMBEDDING_MODEL=sentinel-hash-embed-1
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_REPEAT_RUNS=3

OCR_ENABLED=0

SEED_ON_STARTUP=1
CORS_ORIGINS=https://your-frontend.vercel.app

# --- environments ----------------------------------------------------------
# SENTINEL_ENV=production makes the API refuse to start unless SECRET_KEY is a
# long random value, SEED_ON_STARTUP=0, DEMO_MODE=0, CORS_ORIGINS is explicit and
# DATABASE_URL is PostgreSQL. It lists every problem at once.
SENTINEL_ENV=development

# Password given to the seeded demo users. There is no hard-coded default:
# leave this empty and the seeder generates a random one and prints it once.
# Demo users: tom@northwind.example (manager), ada@northwind.example (admin).
SEED_PASSWORD=

# --- abuse limits (per IP, per minute) -------------------------------------
LOGIN_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20

# --- one-click demo (POST /v1/demo/load, GET /v1/demo/status, POST /v1/demo/reset) ---
# 1 locally; the production render.yaml sets 0.
DEMO_MODE=1
DEMO_RATE_LIMIT_PER_MINUTE=3
DEMO_ANALYSIS_CONCURRENCY=4
