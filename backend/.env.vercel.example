# ─────────────────────────────────────────────────────────────────────────────
# Sentinel AI — BACKEND environment for Vercel (FastAPI / Python)
#
# This file is a REFERENCE. Vercel does not read it; paste these into
#   Vercel → your backend project → Settings → Environment Variables
# (or run the CLI commands in docs/DEPLOY-VERCEL.md §3).
#
# Replace every <PLACEHOLDER>. Never commit real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. Database (REQUIRED — SQLite cannot work on Vercel) ────────────────────
# Vercel's filesystem is read-only except /tmp, and /tmp is per-instance and
# wiped between invocations, so a SQLite file would lose every row at random.
# Use any Postgres with pgvector: Neon (free), Supabase, Railway, Render.
#
# IMPORTANT: keep the `+psycopg` driver in the scheme. Neon/Supabase hand you
# `postgresql://…`; SQLAlchemy would then look for psycopg2, which is not
# installed. `postgresql+psycopg://` is the one that works here.
# Neon pooled host is the right choice for serverless (…-pooler.…).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# ── 2. Security (REQUIRED) ───────────────────────────────────────────────────
# 32+ random characters. Generate with:  openssl rand -hex 32
SECRET_KEY=<PASTE_A_64_CHAR_RANDOM_HEX_STRING>
ACCESS_TOKEN_TTL_MINUTES=720
AUTH_MODE=local

# ── 3. Which operating mode ──────────────────────────────────────────────────
# SENTINEL_ENV=production  → every guard is enforced and DEMO_MODE must be 0
#                            (no "Load demo data" button for visitors).
# SENTINEL_ENV=development → guards are not enforced; the demo works. Correct for
#                            a hackathon/judging link, but the API is then a public
#                            demo and anyone can POST /v1/demo/reset.
# Pick ONE pair:
SENTINEL_ENV=development
DEMO_MODE=1
SEED_ON_STARTUP=1

# Production alternative (delete the three lines above and use these instead):
# SENTINEL_ENV=production
# DEMO_MODE=0
# SEED_ON_STARTUP=0

# ── 4. AI provider (no key, no spend) ────────────────────────────────────────
LLM_PROVIDER=local
LLM_MODEL=sentinel-local-1
EMBEDDING_MODEL=sentinel-hash-embed-1
# Only if LLM_PROVIDER=openai|anthropic (adds cost):
# LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1

# ── 5. Storage ───────────────────────────────────────────────────────────────
# local + /tmp works for the demo (uploads and the seeded guideline live for the
# life of the instance). For durable uploads use S3-compatible storage.
STORAGE_BACKEND=local
STORAGE_DIR=/tmp/sentinel-storage
MAX_UPLOAD_MB=20
# STORAGE_BACKEND=s3
# S3_BUCKET=
# S3_REGION=

# ── 6. CORS — the FRONTEND origin exactly, no trailing slash ─────────────────
# The browser only talks to the Next server, which proxies /v1, so CORS is not
# normally exercised. Set it anyway: it is required by the production guard and
# it is what protects you if anyone points a browser straight at the API.
CORS_ORIGINS=https://sentinel-g0n9ucjzd-inkoolm-hackathon.vercel.app

# ── 7. Rate limits (calls per minute per IP) ─────────────────────────────────
LOGIN_RATE_LIMIT_PER_MINUTE=10
UPLOAD_RATE_LIMIT_PER_MINUTE=20
DEMO_RATE_LIMIT_PER_MINUTE=3
DEMO_SESSION_RATE_LIMIT_PER_MINUTE=30
DEMO_ANALYSIS_CONCURRENCY=4

# ── 8. Optional ──────────────────────────────────────────────────────────────
# Demo password for rows seeded by SEED_ON_STARTUP. Leave empty and a random one
# is generated and logged once; the one-click demo never needs a password
# because it uses POST /v1/demo/session.
SEED_PASSWORD=
# OCR for image uploads (needs the tesseract binary in the image):
OCR_ENABLED=0
